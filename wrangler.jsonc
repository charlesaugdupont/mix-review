{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mix-review",
  "compatibility_date": "2025-09-27",
  "main": "worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // WhatsApp digest: every day at 09:00 Amsterdam. Both UTC hours are listed so it
  // works in summer (UTC+2) and winter (UTC+1); worker.js ignores the one that isn't 09:00.
  "triggers": {
    "crons": ["0 7,8 * * *"]
  },
  "vars": {
    "SUPABASE_URL": "https://nxmodpianwotdvpixjqp.supabase.co",
    "APP_URL": "https://mix-review.charlesdupont1997.workers.dev/"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`):
  //   SUPABASE_SERVICE_KEY  – Supabase secret/service_role key (bypasses RLS; server-side only)
  //   DIGEST_ADMIN_TOKEN    – any long random string; protects /api/digest
}